        if (produk->prev != NULL) {
            produk->prev->next = produk->next;
        } else {
            head_produk = produk->next;
        }
        
        if (produk->next != NULL) {
            produk->next->prev = produk->prev;
        } else {
            tail_produk = produk->prev;
        }
        
        delete produk;
        cout << "Produk berhasil dihapus!\n";
    }
    
