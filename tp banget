    getline(cin, username);
    cout << "Password: ";
    getline(cin, password);
    
    Pemilik* pemilik = listPemilik.findPemilikByUsername(username);
    if(pemilik && pemilik->password == password) {
        if(!pemilik->aktif) {
            cout << "Akun Anda dinonaktifkan. Hubungi administrator.\n";
            return;
