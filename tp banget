                    }
                }
            } else if (jenis == "semua") {
                tampil = true;
            }
            
            if (tampil) {
                found = true;
                total_harian += current->total;
                
                string detail_str = "";
                TransaksiDetail* detail = current->detail;
                while (detail != NULL) {
                    detail_str += detail->nama_produk + "(" + intToString(detail->jumlah) + ") ";
